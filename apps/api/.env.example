# Rawli API
PORT=4000
HOST=0.0.0.0

# Optional AI analysis. If unset, the API returns deterministic fallback analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_ANALYSIS_TIMEOUT_MS=25000

# Optional Redis cache. If Redis is unavailable, requests continue without cache.
REDIS_URL=redis://localhost:6379

# Production database. Use the Supabase pooled Postgres connection string here.
# SUPABASE_DB_URL wins over DATABASE_URL when both are set.
SUPABASE_DB_URL=
DATABASE_URL=
SUPABASE_DB_SSL=true
SUPABASE_DB_POOL_MAX=15

# Local fallback when no Postgres URL is configured.
TRADING_PROFILE_DB_PATH=.data/trading-profiles.sqlite

# Legacy JSON profile store. Used only as an idempotent migration source.
TRADING_PROFILE_STORE_PATH=.data/trading-profiles.json

# Polymarket upstreams. Defaults are provided in @smartmarket/config.
POLYMARKET_GEOBLOCK_URL=https://polymarket.com/api/geoblock
POLYMARKET_BRIDGE_BASE_URL=https://bridge.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_BASE_URL=https://data-api.polymarket.com
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com

# Server-side Polymarket builder credentials. Required for deploying and
# executing Polymarket Deposit Wallet actions through the builder relayer.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Polygon Gas Assist. Sends a tiny POL top-up only when a funded pUSD wallet has
# insufficient Polygon gas. Keep the relayer wallet lightly funded and rate-limited.
GAS_ASSIST_ENABLED=false
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_GAS_RELAYER_PRIVATE_KEY=
GAS_ASSIST_MIN_PUSD_BALANCE=2
GAS_ASSIST_MIN_POL_BALANCE=0.02
GAS_ASSIST_TOPUP_POL=0.05
GAS_ASSIST_MAX_TOPUP_POL=0.08
GAS_ASSIST_COOLDOWN_HOURS=24

# Platform fee shown in trade previews. 50 bps = 0.5%. Set ENABLE to "false" to hide.
PLATFORM_FEE_BPS=50
ENABLE_PLATFORM_FEE=true

# Premium analysis payment (BNB Chain USDT)
# Disabled by default during testing. Set to true to reactivate the x402-style
# USDT unlock gate without changing code.
PREMIUM_ANALYSIS_FEE_ENABLED=false
# Tokenized stock reports can be charged independently while prediction reports
# remain free during testing. Set true to require 1 USDT for stock:* reports.
STOCK_ANALYSIS_FEE_ENABLED=false
PAYMENT_RECEIVER_ADDRESS=0x...
# Premium RPC — set to your NodeReal / QuickNode / Ankr endpoint for best reliability.
# If unset, system auto-cycles through 8 public BSC fallback nodes.
#   NodeReal free:  https://bsc-mainnet.nodereal.io/v1/YOUR_KEY
#   QuickNode:      https://YOUR_ENDPOINT.bsc.quiknode.pro/YOUR_TOKEN/
#   Ankr paid:      https://rpc.ankr.com/bsc/YOUR_KEY
BSC_RPC_URL=https://bsc-dataseed1.binance.org
PAYMENT_TX_MAX_AGE=600

# Polygon RPC — used for gas assist relay + deposit wallet operations (all Polymarket trading)
# Alchemy free tier (300M CUs/day, best for Polygon): https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# QuickNode: https://YOUR_ENDPOINT.matic.quiknode.pro/YOUR_TOKEN/
# Infura: https://polygon-mainnet.infura.io/v3/YOUR_KEY
# Falls back through 6 public nodes if unset.
POLYGON_RPC_URL=https://polygon-rpc.com

# Optional secondary market source. Keep disabled in web unless intentionally used.
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Referral reward secret. Optional — if set, the POST /referral/reward endpoint
# requires this value in the X-Referral-Secret header (call it from your own services).
REFERRAL_REWARD_SECRET=
