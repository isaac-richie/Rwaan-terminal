# Rawali Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Required for wallet login and embedded wallet controls.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional Polymarket Builder Profile code. This is a bytes32 public attribution
# code from polymarket.com/settings?tab=builder and is attached to every order.
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=

# Public Polymarket relayer URL. Used client-side only for deterministic
# deposit-wallet derivation; authenticated relayer submission must stay server-side.
NEXT_PUBLIC_POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com

# Optional secondary market source. Leave false for Polymarket-only launch.
NEXT_PUBLIC_ENABLE_KALSHI=false
