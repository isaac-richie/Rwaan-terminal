# Rawli Web
# PRODUCTION: replace with your deployed API URL (e.g. https://rawli-api.fly.dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Required for wallet login and embedded wallet controls.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional Polymarket Builder Profile code. This is a bytes32 public attribution
# code from polymarket.com/settings?tab=builder and is attached to every order.
NEXT_PUBLIC_POLYMARKET_BUILDER_CODE=

# Public Polymarket relayer URL. Used client-side only for deterministic
# deposit-wallet derivation; authenticated relayer submission must stay server-side.
NEXT_PUBLIC_POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com

# Optional secondary market source. Leave false for Polymarket-only launch.
NEXT_PUBLIC_ENABLE_KALSHI=false

# Optional full-page Polymarket region gate. Keep disabled unless the check is
# running from an environment that can reliably reflect the user's own IP.
NEXT_PUBLIC_ENABLE_POLYMARKET_GEOBLOCK=false

# Disabled by default during testing. Set to true only when the backend
# PREMIUM_ANALYSIS_FEE_ENABLED flag is also true.
NEXT_PUBLIC_PREMIUM_ANALYSIS_FEE_ENABLED=false

# Polygon RPC — used as the default RPC when adding Polygon to user wallets.
# Set to your Alchemy / QuickNode endpoint for best reliability.
# Falls back to polygon-rpc.com if unset.
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
